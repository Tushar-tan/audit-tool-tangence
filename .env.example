DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GEMINI_API_KEY="your_gemini_api_key_optional"
OPENAI_API_KEY="your_openai_api_key_optional"
NODE_ENV="development"

# Cloud Screenshot Hosting (Direct URLs like Lightshot, 0 local disk usage)
# Get a free API key at: https://api.imgbb.com
IMGBB_API_KEY=""

# Screenshot retention window in days (default: 3 days, auto-deleted)
SCREENSHOT_RETENTION_DAYS="3"
